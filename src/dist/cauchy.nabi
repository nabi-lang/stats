// The Cauchy distribution with location x0 and scale gamma.

use pkg::StatsError;
use pkg::dist::{Continuous, Distribution, check, draw};
use std::random::Rng;

const PI: f64 = 3.141592653589793;

/// The Cauchy (Lorentz) distribution with location `x0` and scale
/// `gamma > 0`: Student's t with one degree of freedom, shifted and
/// scaled. It has no mean or variance (both NaN).
///
/// ```nabi
/// use stats::{Cauchy, Continuous};
///
/// let d = try Cauchy::new(0.0, 1.0);
/// assert(d.cdf(1.0) == 0.75 && d.ppf(0.75) == 1.0000000000000002);
/// ```
#[derive(Clone, Copy, PartialEq, Debug)]
pub struct Cauchy {
    pub(pkg) x0: f64;
    pub(pkg) g: f64;
}

impl Cauchy {
    /// Cauchy(x0, gamma); `x0` finite, `gamma` finite and > 0.
    pub fn new(x0: f64, gamma: f64) throws (StatsError) -> Cauchy {
        try check(x0.is_finite() && gamma > 0.0 && gamma.is_finite(), f"Cauchy: x0 = {x0}, gamma = {gamma}; x0 must be finite and gamma finite and > 0");
        Cauchy { x0: x0, g: gamma }
    }

    /// The location (the median).
    pub fn location(self) -> f64 { self.x0 }

    /// The scale (half the interquartile range).
    pub fn scale(self) -> f64 { self.g }
}

impl Distribution for Cauchy {
    type Value = f64;
    fn sample<G: Rng>(self, ref g: G) -> f64 { self.ppf(draw::open01(ref g)) }
}

impl Continuous for Cauchy {
    fn pdf(self, x: f64) -> f64 {
        let z = (x - self.x0) / self.g;
        1.0 / (PI * self.g * (1.0 + z * z))
    }
    fn logpdf(self, x: f64) -> f64 {
        let z = (x - self.x0) / self.g;
        -(PI * self.g).ln() - (z * z).ln_1p()
    }
    // atan2(1, -z) / pi keeps both tails accurate.
    fn cdf(self, x: f64) -> f64 { 1.0.atan2((self.x0 - x) / self.g) / PI }
    fn sf(self, x: f64) -> f64 { 1.0.atan2((x - self.x0) / self.g) / PI }
    fn ppf(self, p: f64) -> f64 {
        if !(p >= 0.0 && p <= 1.0) { return f64::NAN; }
        if p == 0.0 { return f64::NEG_INFINITY; }
        if p == 1.0 { return f64::INFINITY; }
        if p == 0.5 { return self.x0; }
        let t = if p < 0.5 { -1.0 / (PI * p).tan() } else { 1.0 / (PI * (1.0 - p)).tan() };
        self.x0 + self.g * t
    }
    fn isf(self, q: f64) -> f64 {
        if !(q >= 0.0 && q <= 1.0) { return f64::NAN; }
        2.0 * self.x0 - self.ppf(q)
    }
    fn mean(self) -> f64 { f64::NAN }
    fn var(self) -> f64 { f64::NAN }
    fn median(self) -> f64 { self.x0 }
}
