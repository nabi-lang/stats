// Descriptive statistics, quantiles, histograms and correlations
// against NumPy 2.0 and SciPy 1.13 on fixed data (the constants are
// their outputs), plus accuracy and edge cases.

use pkg::tests::suite::{EPS, close, expect, rel, throws_kind, uniform};
use pkg::{Bins, CorrMethod, QuantileMethod, Ties};
use core::array::{Array, Matrix, Vector};

