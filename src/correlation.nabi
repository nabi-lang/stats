// Ranks, covariance and correlation: Pearson's r, Spearman's rho (r of
// the ranks) and Kendall's tau-b by Knight's (1966) O(n log n)
// algorithm, for pairs of samples and as matrices over the columns of
// a data matrix (one observation per row, one variable per column).

use pkg::StatsError;
use pkg::data::{Sample, Values};
use pkg::descriptive::{mean_of, span_mean};
use pkg::error::{need, same};
use pkg::kernel::{argsort, buf};
use bare::mem::GcBuf;
use core::array::{Array, Matrix, Vector};

/// How `rankdata` ranks equal values (SciPy's `method`).
///
/// ```nabi
/// use stats::Ties;
///
/// let x = [10.0, 20.0, 10.0, 30.0];
/// assert(stats::rankdata(x)[0] == 1.5);
/// assert(stats::rankdata(x, Ties::Min)[2] == 1.0);
/// assert(stats::rankdata(x, Ties::Dense)[3] == 3.0);
/// ```
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum Ties {
    /// The mean of the ranks the group spans (the default).
    Average,
    /// The lowest rank of the group.
    Min,
    /// The highest rank of the group.
    Max,
    /// Ranks 1, 2, 3, ... over the distinct values.
    Dense,
    /// Distinct ranks in order of appearance.
    Ordinal,
}

/// The ranks (1-based) of `values` with ties by `ties`, into a buffer.
pub(pkg) fn ranks(v: Values, ties: Ties) -> Values {
    let n = v.n;
    let order = argsort(v.d, 0, n);
    let out = Values::new(n);
    let i = 0usize;
    let dense = 0.0;
    while i < n {
        let j = i + 1;
        unsafe {
            while j < n && v.at(order.get(j)) == v.at(order.get(i)) { j += 1; }
        }
        dense += 1.0;
        for k in i..j {
            let r = match ties {
                Ties::Average => 0.5 * ((i + 1) as f64 + j as f64),
                Ties::Min => (i + 1) as f64,
                Ties::Max => j as f64,
                Ties::Dense => dense,
                Ties::Ordinal => (k + 1) as f64,
            };
            unsafe { out.d.set(order.get(k), r); }
        }
        i = j;
    }
    out
}

/// The ranks of the values, 1 for the smallest, ties by `ties`
/// (default `Average`, the mid-rank). O(n log n). SciPy: `rankdata`.
///
/// ```nabi
/// let r = stats::rankdata([3.0, 1.0, 2.0]);
/// assert(r[0] == 3.0 && r[1] == 1.0);
/// ```
pub fn rankdata<X: Sample>(x: X, ties: Ties = Ties::Average) -> Vector<f64> { ranks(x.values(), ties).to_vector() }

/// Pearson's r of two runs of equal length (two-pass, clamped to [-1,
/// 1]); NaN when either is constant.
pub(pkg) fn r_of(x: Values, y: Values) -> f64 {
    let n = x.n;
    let (mx, my) = (span_mean(x, 0, n), span_mean(y, 0, n));
    let (sxy, sxx, syy) = (0.0, 0.0, 0.0);
    for i in 0..n {
        let (a, b) = (x.at(i) - mx, y.at(i) - my);
        sxy += a * b;
        sxx += a * a;
        syy += b * b;
    }
    if sxx == 0.0 || syy == 0.0 { return f64::NAN; }
    // One square root of the product keeps an exact linear relation at
    // exactly +-1; the split form only when the product would overflow.
    let p = sxx * syy;
    let d = if p.is_finite() { p.sqrt() } else { sxx.sqrt() * syy.sqrt() };
    (sxy / d).clamp(-1.0, 1.0)
}

fn pair<X: Sample, Y: Sample>(what: str, x: X, y: Y) throws (StatsError) -> (Values, Values) {
    let (a, b) = (x.values(), y.values());
    try same(what, a.n, b.n);
    try need(what, 2, a.n);
    (a, b)
}

/// Pearson's correlation coefficient. NaN when either sample is
/// constant. Throws `ShapeMismatch` for unequal lengths, `TooFew`
/// below 2 pairs.
///
/// ```nabi
/// assert(try stats::pearson([1.0, 2.0, 3.0], [2.0, 4.0, 6.5]) > 0.99);
/// assert(try stats::pearson([1.0, 2.0, 3.0], [3.0, 2.0, 1.0]) == -1.0);
/// ```
pub fn pearson<X: Sample, Y: Sample>(x: X, y: Y) throws (StatsError) -> f64 {
    let (a, b) = try pair("pearson", x, y);
    r_of(a, b)
}

/// Spearman's rank correlation: Pearson's r of the mid-ranks.
///
/// ```nabi
/// assert(try stats::spearman([1.0, 2.0, 3.0, 4.0], [1.0, 4.0, 9.0, 16.0]) == 1.0);
/// ```
pub fn spearman<X: Sample, Y: Sample>(x: X, y: Y) throws (StatsError) -> f64 {
    let (a, b) = try pair("spearman", x, y);
    r_of(ranks(a, Ties::Average), ranks(b, Ties::Average))
}

/// Kendall's tau-b: `(concordant - discordant) / sqrt((n0 - n1) (n0 -
/// n2))`, which corrects for ties in either sample. Knight's
/// algorithm, O(n log n).
///
/// ```nabi
/// let t = try stats::kendall([12.0, 2.0, 1.0, 12.0, 2.0], [1.0, 4.0, 7.0, 1.0, 0.0]);
/// assert((t + 0.4714045207910316).abs() < 1e-15);
/// ```
pub fn kendall<X: Sample, Y: Sample>(x: X, y: Y) throws (StatsError) -> f64 {
    let (a, b) = try pair("kendall", x, y);
    knight(a, b).0
}

/// The tie and pair counts of Knight's algorithm: `(tau_b, n0, n1, n2,
/// n3, s)` with `n0` all pairs, `n1` / `n2` pairs tied in x / y, `n3`
/// tied in both and `s = concordant - discordant`.
pub(pkg) fn knight(x: Values, y: Values) -> (f64, f64, f64, f64, f64, f64) {
    let n = x.n;
    // Lexicographic order by (x, y): stable sort by y, then by x.
    let oy = argsort(y.d, 0, n);
    let xs = buf::<f64>(n);
    unsafe {
        for i in 0..n { xs.set(i, x.at(oy.get(i))); }
    }
    let ox = argsort(xs, 0, n);
    let perm = buf::<usize>(n);
    unsafe {
        for i in 0..n { perm.set(i, oy.get(ox.get(i))); }
    }
    let (n1, n3) = (0.0, 0.0);
    let i = 0usize;
    unsafe {
        while i < n {
            let j = i + 1;
            while j < n && x.at(perm.get(j)) == x.at(perm.get(i)) { j += 1; }
            let t = (j - i) as f64;
            n1 += t * (t - 1.0) / 2.0;
            let k = i;
            while k < j {
                let m = k + 1;
                while m < j && y.at(perm.get(m)) == y.at(perm.get(k)) { m += 1; }
                let u = (m - k) as f64;
                n3 += u * (u - 1.0) / 2.0;
                k = m;
            }
            i = j;
        }
    }
    let ys = buf::<f64>(n);
    unsafe {
        for i in 0..n { ys.set(i, y.at(perm.get(i))); }
    }
    let swaps = inversions(ys, n);
    let n2 = 0.0;
    let i = 0usize;
    unsafe {
        while i < n {
            let j = i + 1;
            while j < n && ys.get(j) == ys.get(i) { j += 1; }
            let t = (j - i) as f64;
            n2 += t * (t - 1.0) / 2.0;
            i = j;
        }
    }
    let nf = n as f64;
    let n0 = nf * (nf - 1.0) / 2.0;
    let s = n0 - n1 - n2 + n3 - 2.0 * swaps;
    let den = ((n0 - n1) * (n0 - n2)).sqrt();
    let tau = if den == 0.0 { f64::NAN } else { (s / den).clamp(-1.0, 1.0) };
    (tau, n0, n1, n2, n3, s)
}

/// Sort `d[0..n]` rising (bottom-up merge sort) and return the number
/// of pairs `i < j` with `d[i] > d[j]` it undid.
fn inversions(d: GcBuf<f64>, n: usize) -> f64 {
    let t = buf::<f64>(n);
    let (src, dst) = (d, t);
    let count = 0.0;
    let w = 1usize;
    while w < n {
        let i = 0usize;
        while i < n {
            let m = (i + w).min(n);
            let e = (i + 2 * w).min(n);
            let (p, q, k) = (i, m, i);
            unsafe {
                while p < m && q < e {
                    if src.get(q) < src.get(p) {
                        dst.set(k, src.get(q));
                        count += (m - p) as f64;
                        q += 1;
                    } else {
                        dst.set(k, src.get(p));
                        p += 1;
                    }
                    k += 1;
                }
                while p < m {
                    dst.set(k, src.get(p));
                    p += 1;
                    k += 1;
                }
                while q < e {
                    dst.set(k, src.get(q));
                    q += 1;
                    k += 1;
                }
            }
            i = e;
        }
        let x = src;
        src = dst;
        dst = x;
        w *= 2;
    }
    if !bare::mem::buf_same(src, d) {
        unsafe {
            for i in 0..n { d.set(i, src.get(i)); }
        }
    }
    count
}

/// How `corr` measures association.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
///
/// ```nabi
/// use core::array::Matrix;
/// use stats::CorrMethod;
///
/// let x: Matrix<f64> = [[1, 3], [2, 1], [3, 2]];
/// assert((try stats::corr(x, CorrMethod::Kendall))[0, 1] == -1.0 / 3.0);
/// ```
pub enum CorrMethod {
    /// Pearson's r (linear).
    Pearson,
    /// Spearman's rho (monotone, on ranks).
    Spearman,
    /// Kendall's tau-b (concordance of pairs).
    Kendall,
}

/// Column `j` of `x` as a contiguous run.
fn column(x: Matrix<f64>, j: usize) -> Values { Sample::values(x[:, j]) }

/// The covariance matrix of the columns of `x` (rows are observations,
/// as pandas' `DataFrame.cov`; NumPy's `cov(x, rowvar=False)`),
/// dividing by `n - ddof` (default 1, the unbiased estimate). The
/// columns are centered by their means (two-pass), then `Xc^T Xc` is
/// one linalg product. O(n p^2). Throws `TooFew` when `n <= ddof`.
///
/// ```nabi
/// use core::array::Matrix;
///
/// let x: Matrix<f64> = [[1, 2], [2, 4], [3, 7]];
/// let c = try stats::cov(x);
/// assert(c[0, 0] == 1.0 && c[0, 1] == 2.5 && c[1, 1] == 6.333333333333333);
/// ```
pub fn cov(x: Matrix<f64>, ddof: usize = 1) throws (StatsError) -> Matrix<f64> {
    let s = x.shape();
    let (n, p) = (s[0], s[1]);
    try need("cov", ddof + 1, n);
    let means: List<f64> = List::from_fn(p, |j| mean_of(column(x, j)));
    let mu: Vector<f64> = Array::view_list(means, [p]);
    let xc = x .- mu;
    let g = try! linalg::matmul(xc.t(), xc);
    let c = g ./ ((n - ddof) as f64);
    // Exact symmetry.
    for i in 0..p {
        for j in 0..i { c[j, i] = c[i, j]; }
    }
    c
}

/// The correlation matrix of the columns of `x` by `method` (default
/// Pearson). The diagonal is 1 (NaN for a constant column).
///
/// ```nabi
/// use core::array::Matrix;
/// use stats::CorrMethod;
///
/// let x: Matrix<f64> = [[1, 1], [2, 4], [3, 9], [4, 16]];
/// assert((try stats::corr(x, CorrMethod::Spearman))[0, 1] == 1.0);
/// ```
pub fn corr(x: Matrix<f64>, method: CorrMethod = CorrMethod::Pearson) throws (StatsError) -> Matrix<f64> {
    let s = x.shape();
    let (n, p) = (s[0], s[1]);
    try need("corr", 2, n);
    let cols: List<Values> = List::from_fn(p, |j| {
        let c = column(x, j);
        if method == CorrMethod::Spearman { ranks(c, Ties::Average) } else { c }
    });
    let out: Matrix<f64> = Array::zeros([p, p]);
    if method != CorrMethod::Kendall {
        let c = try cov(x, 0);
        if method == CorrMethod::Spearman {
            let r = Values::new(n * p);
            for j in 0..p {
                for i in 0..n { unsafe { r.d.set(i * p + j, cols[j].at(i)); } }
            }
            c = try cov(pkg::data::shaped(r.d, [n, p]), 0);
        }
        for i in 0..p {
            for j in 0..p {
                let d = (c[i, i] * c[j, j]).sqrt();
                out[i, j] = if i == j { if c[i, i] > 0.0 { 1.0 } else { f64::NAN } } else if d > 0.0 { (c[i, j] / d).clamp(-1.0, 1.0) } else { f64::NAN };
            }
        }
        return out;
    }
    for i in 0..p {
        out[i, i] = 1.0;
        for j in 0..i {
            let t = knight(cols[i], cols[j]).0;
            out[i, j] = t;
            out[j, i] = t;
        }
    }
    out
}
