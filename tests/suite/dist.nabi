// Distributions: values against SciPy 1.13 (the constants), tails
// against mpmath, round trips, sums of the PMF, closed-form moments,
// parameter errors and maximum-likelihood fits.

use pkg::tests::suite::{close, expect, rel, throws_kind};
use pkg::{Continuous, Discrete};
use core::array::{Matrix, Vector};

fn check<D: Continuous>(name: str, d: D, pts: List<List<f64>>, qs: List<f64>, mean: f64, var: f64) {
    for p in pts {
        let x = p[0];
        rel(d.pdf(x), p[1], 1e-13, f"{name}: pdf({x})");
        rel(d.logpdf(x), p[1].ln(), 1e-13, f"{name}: logpdf({x})");
        rel(d.cdf(x), p[2], 1e-13, f"{name}: cdf({x})");
        rel(d.sf(x), p[3], 1e-13, f"{name}: sf({x})");
    }
    let ps = [0.01, 0.3, 0.5, 0.8, 0.999];
    for i in 0..5 {
        let q = d.ppf(ps[i]);
        if qs[i] == 0.0 { close(q, 0.0, 1e-15, f"{name}: ppf at 0") } else { rel(q, qs[i], 1e-12, f"{name}: ppf({ps[i]})"); }
    }
    for p in [1e-9, 0.02, 0.37, 0.5, 0.91, 0.999999] {
        // Relative 1e-12, with an absolute floor for the rounding of a
        // location (Uniform's a + p (b - a)).
        // location (Uniform's a + p (b - a)), or the best double (Beta near
        // 1, where doubles are 1e-16 apart): p between the neighbours.
        let x = d.ppf(p);
        let ok = (d.cdf(x) - p).abs() <= 1e-12 * p + 1e-15 || (d.cdf(x.next_down()) <= p && p <= d.cdf(x.next_up()));
        expect(ok, f"{name}: cdf(ppf({p})) = {d.cdf(x)}");
        let y = d.isf(p);
        let ok2 = (d.sf(y) - p).abs() <= 1e-12 * p + 1e-15 || (d.sf(y.next_up()) <= p && p <= d.sf(y.next_down()));
        expect(ok2, f"{name}: sf(isf({p})) = {d.sf(y)}");
    }
    expect(d.ppf(-0.1) != d.ppf(-0.1) && d.ppf(1.1) != d.ppf(1.1), f"{name}: ppf outside [0, 1]");
    rel(d.mean(), mean, 1e-14, f"{name}: mean");
    rel(d.var(), var, 1e-13, f"{name}: var");
    let i = d.interval(0.9);
    rel(d.cdf(i.hi) - d.cdf(i.lo), 0.9, 1e-12, f"{name}: interval");
}

fn check_discrete<D: Discrete>(name: str, d: D, pts: List<List<f64>>, qs: List<i64>, mean: f64, var: f64) {
    for p in pts {
        let k = p[0] as i64;
        rel(d.pmf(k), p[1], 1e-13, f"{name}: pmf({k})");
        rel(d.cdf(k), p[2], 1e-13, f"{name}: cdf({k})");
        rel(d.sf(k), p[3], 1e-13, f"{name}: sf({k})");
        expect(d.ppf(d.cdf(k)) == k, f"{name}: ppf(cdf({k}))");
    }
    let ps = [0.01, 0.3, 0.5, 0.8, 0.999];
    for i in 0..5 { expect(d.ppf(ps[i]) == qs[i], f"{name}: ppf({ps[i]}) = {d.ppf(ps[i])}, SciPy {qs[i]}"); }
    let s = 0.0;
    for k in -1..400 { s += d.pmf(k); }
    close(s, 1.0, 1e-13, f"{name}: pmf sums to 1");
    rel(d.mean(), mean, 1e-14, f"{name}: mean");
    rel(d.var(), var, 1e-13, f"{name}: var");
}

#[test]
fn continuous_values() {
    // StudentT quantiles from mpmath: SciPy 1.13 is off by up to 4e-12.
    // Normal::new(1.5, 2.0)
    check("Normal::new(1.5, 2.0)", try! pkg::Normal::new(1.5, 2.0), [[-3.0, 0.01586982591783371, 0.0122244726550447, 0.9877755273449553], [0.0, 0.15056871607740221, 0.2266273523768682, 0.7733726476231317], [1.5, 0.19947114020071635, 0.5, 0.5], [4.0, 0.09132454269451096, 0.8943502263331446, 0.10564977366685535], [9.0, 0.00017629784118372273, 0.9999115827147992, 8.841728520080377e-05]], [-3.1526957480816815, 0.4511989745839182, 1.5, 3.1832424671458286, 7.680464612335626], 1.5, 4.0);
    // LogNormal::new(0.3, 0.8)
    check("LogNormal::new(0.3, 0.8)", try! pkg::LogNormal::new(0.3, 0.8), [[0.05, 0.0020582812828553974, 1.8971153782154662e-05, 0.9999810288462179], [0.7, 0.5086413074266231, 0.20586765732599843, 0.7941323426740016], [1.3, 0.3831740912168829, 0.48123881293712906, 0.5187611870628709], [4.0, 0.04958871309427595, 0.9127472058157243, 0.08725279418427567], [15.0, 0.0003583200177212983, 0.9986940313976121, 0.0013059686023878983]], [0.20990960375821024, 0.8873458967567902, 1.3498588075760032, 2.646656080728881, 15.993555261418141], 1.8589280418463423, 3.097891397428475);
    // Uniform::new(-1.0, 3.0)
    check("Uniform::new(-1.0, 3.0)", try! pkg::Uniform::new(-1.0, 3.0), [[-0.5, 0.25, 0.125, 0.875], [0.0, 0.25, 0.25, 0.75], [1.0, 0.25, 0.5, 0.5], [2.9, 0.25, 0.975, 0.025000000000000022]], [-0.96, 0.19999999999999996, 1.0, 2.2, 2.996], 1.0, 1.3333333333333333);
    // Exponential::new(1.7)
    check("Exponential::new(1.7)", try! pkg::Exponential::new(1.7), [[0.01, 1.6713442638793463, 0.016856315365090364, 0.9831436846349096], [0.5, 0.7266053843128354, 0.5725850680512733, 0.4274149319487267], [2.0, 0.05673455893255434, 0.9666267300396739, 0.03337326996032608], [9.0, 3.852506217201714e-07, 0.9999997733819872, 2.2661801277657141e-07]], [0.005911962266765554, 0.20980879055219556, 0.40773363562349724, 0.9467281837847651, 4.063385458224786], 0.5882352941176471, 0.34602076124567477);
    // Gamma::new(2.5, 1.3)
    check("Gamma::new(2.5, 1.3)", try! pkg::Gamma::new(2.5, 1.3), [[0.05, 0.004200072548312871, 8.493248901740169e-05, 0.9999150675109826], [1.0, 0.18089757337093829, 0.09141085871680255, 0.9085891412831975], [3.2, 0.19063288310699864, 0.5746599842720848, 0.42534001572791524], [12.0, 0.0015900293755549372, 0.997579731309553, 0.002420268690447012]], [0.3602937498733802, 1.9499402862939395, 2.828449124212093, 4.738029482321825, 13.33475367408137], 3.25, 4.2250000000000005);
    // Gamma::new(0.4, 2.0)
    check("Gamma::new(0.4, 2.0)", try! pkg::Gamma::new(0.4, 2.0), [[0.001, 21.546566516242947, 0.053885658304932776, 0.9461143416950673], [0.3, 0.6055894441985757, 0.5060358722459368, 0.4939641277540632], [2.0, 0.08292447723310145, 0.8805261050857099, 0.11947389491428964], [10.0, 0.000578259547640054, 0.9989518793317903, 0.0010481206682096617]], [1.4830787919215435e-05, 0.07508377287484609, 0.29015628328687065, 1.2911420349549882, 10.085217176919924], 0.8, 1.6);
    // Beta::new(2.5, 0.7)
    check("Beta::new(2.5, 0.7)", try! pkg::Beta::new(2.5, 0.7), [[0.01, 0.0014089853154641918, 5.631075838213447e-06, 0.9999943689241619], [0.3, 0.25689135846847283, 0.029814024845250458, 0.9701859751547496], [0.77, 1.4750772406548938, 0.3807878339981222, 0.6192121660018778], [0.999, 11.14154086709364, 0.9840694524243256, 0.01593054757567424]], [0.19597479033740994, 0.7097758912148804, 0.8415021788414839, 0.9616183534697126, 0.9999808507554779], 0.78125, 0.04069010416666666);
    // Beta::new(30.0, 50.0)
    check("Beta::new(30.0, 50.0)", try! pkg::Beta::new(30.0, 50.0), [[0.2, 0.015932109551747738, 0.0001722945272179603, 0.999827705472782], [0.37, 7.354124338249637, 0.4709173219708641, 0.5290826780291359], [0.5, 0.550369534108494, 0.9880901035709994, 0.01190989642900064]], [0.25539221947878094, 0.3458138914762153, 0.3739533593876209, 0.4202693297611027, 0.5466133922200329], 0.375, 0.0028935185185185184);
    // ChiSquared::new(5.0)
    check("ChiSquared::new(5.0)", try! pkg::ChiSquared::new(5.0), [[0.2, 0.010762281724769078, 0.0008861387888124423, 0.9991138612111875], [3.0, 0.15418032980376928, 0.3000141641213724, 0.6999858358786276], [11.07, 0.019328149897682452, 0.9499903813775945, 0.05000961862240546], [30.0, 6.684262003574906e-06, 0.9999852514189616, 1.4748581038443047e-05]], [0.5542980767282772, 2.9999081327599066, 4.351460191095527, 7.289276126648962, 20.515005652432876], 5.0, 10.0);
    // StudentT::new(3.5)
    check("StudentT::new(3.5)", try! pkg::StudentT::new(3.5), [[-6.0, 0.0015925266691553194, 0.002944476322457821, 0.9970555236775422], [-1.0, 0.21120394361781114, 0.19066862678172278, 0.8093313732182772], [0.4, 0.33620002157826795, 0.6438275532327781, 0.35617244676722193], [2.2, 0.05269950854611862, 0.948833359837272, 0.051166640162727976]], [-4.060711359300083, -0.575338701772231, 0.0, 0.956758833932311, 8.315567604516117], 0.0, 2.3333333333333335);
    // StudentT::new(30.0)
    check("StudentT::new(30.0)", try! pkg::StudentT::new(30.0), [[-2.5, 0.02105701922062158, 0.009057824534033353, 0.9909421754659666], [0.1, 0.39359369563267843, 0.5394951941048645, 0.46050480589513554], [1.7, 0.09510011095327145, 0.9502610622057416, 0.049738937794258434]], [-2.4572615424005915, -0.5300190039065045, 0.0, 0.8537672614712977, 3.385184866829305], 0.0, 1.0714285714285714);
    // FisherF::new(4.0, 12.0)
    check("FisherF::new(4.0, 12.0)", try! pkg::FisherF::new(4.0, 12.0), [[0.1, 0.3589907579737952, 0.01961333477156768, 0.9803866652284322], [1.0, 0.4671936035156267, 0.5550537109375002, 0.4449462890624999], [3.26, 0.04232527154696192, 0.9500352827855362, 0.04996471721446378], [9.0, 0.000640869140625, 0.9986572265625, 0.0013427734374999998]], [0.06957205596287128, 0.5541685863774736, 0.8884782544570923, 1.7684255227259, 9.632726102792533], 1.2, 1.26);
    // Cauchy::new(1.0, 2.0)
    check("Cauchy::new(1.0, 2.0)", try! pkg::Cauchy::new(1.0, 2.0), [[-30.0, 0.0006597096086710688, 0.02050769992472934, 0.9794923000752707], [0.0, 0.12732395447351627, 0.35241638234956674, 0.6475836176504333], [1.0, 0.15915494309189535, 0.5, 0.5], [5.0, 0.03183098861837907, 0.8524163823495667, 0.1475836176504332]], [-62.64103190754771, -0.4530850560107218, 1.0, 3.7527638409423463, 637.6176779711282], f64::NAN, f64::NAN);
    // Laplace::new(0.5, 1.5)
    check("Laplace::new(0.5, 1.5)", try! pkg::Laplace::new(0.5, 1.5), [[-4.0, 0.01659568945595465, 0.024893534183931972, 0.9751064658160681], [0.0, 0.2388437701912631, 0.35826565528689464, 0.6417343447131054], [0.5, 0.3333333333333333, 0.5, 0.5], [3.0, 0.06295853427918728, 0.9055621985812191, 0.09443780141878091]], [-5.368034508142219, -0.2662384356489861, 0.5, 1.874436097811233, 9.821912147633286], 0.5, 4.5);
    // Weibull::new(1.5, 2.0)
    check("Weibull::new(1.5, 2.0)", try! pkg::Weibull::new(1.5, 2.0), [[0.1, 0.16584054092756806, 0.011118072161658006, 0.988881927838342], [1.0, 0.37239168821942203, 0.29781149867344037, 0.7021885013265596], [2.0, 0.27590958087858175, 0.6321205588285577, 0.36787944117144233], [6.0, 0.007193853120769421, 0.9944621692856175, 0.005537830714382473]], [0.09314303369403937, 1.005877429831437, 1.5664395375493028, 2.746710033739222, 7.2541738246789516], 1.805490585901867, 1.5027611392557279);
}

#[test]
fn discrete_values() {
    // Bernoulli::new(0.3)
    check_discrete("Bernoulli::new(0.3)", try! pkg::Bernoulli::new(0.3), [[0.0, 0.6999999999999997, 0.7, 0.3], [1.0, 0.3, 1.0, 0.0]], [0, 0, 0, 1, 1], 0.3, 0.21);
    // Binomial::new(20, 0.3)
    check_discrete("Binomial::new(20, 0.3)", try! pkg::Binomial::new(20, 0.3), [[0.0, 0.0007979226629761174, 0.0007979226629761204, 0.9992020773370239], [3.0, 0.07160367220526213, 0.10708680450373087, 0.8929131954962691], [6.0, 0.1916389827534427, 0.6080098122009244, 0.3919901877990756], [11.0, 0.012006654896137014, 0.9948618384648786, 0.0051381615351214025], [20.0, 3.4867844009999975e-11, 1.0, 0.0]], [2, 5, 6, 8, 13], 6.0, 4.199999999999999);
    // Binomial::new(1000, 0.01)
    check_discrete("Binomial::new(1000, 0.01)", try! pkg::Binomial::new(1000, 0.01), [[0.0, 4.3171247410658215e-05, 4.3171247410658276e-05, 0.9999568287525893], [5.0, 0.03745311160824718, 0.0661395116072514, 0.9338604883927486], [10.0, 0.12574021112620729, 0.5830408033010972, 0.41695919669890275], [25.0, 2.64425579190219e-05, 0.9999844133494706, 1.5586650529345442e-05]], [3, 8, 10, 13, 21], 10.0, 9.9);
    // Poisson::new(4.5)
    check_discrete("Poisson::new(4.5)", try! pkg::Poisson::new(4.5), [[0.0, 0.011108996538242306, 0.011108996538242308, 0.9888910034617577], [2.0, 0.11247858994970336, 0.1735780709100361, 0.8264219290899639], [4.0, 0.18980762054012446, 0.5321035763747152, 0.46789642362528483], [9.0, 0.0231645795826592, 0.9829072671006214, 0.017092732899378595], [15.0, 5.337807738263469e-05, 0.9999797175537863, 2.0282446213707758e-05]], [0, 3, 4, 6, 12], 4.5, 4.5);
    // Poisson::new(120.0)
    check_discrete("Poisson::new(120.0)", try! pkg::Poisson::new(120.0), [[90.0, 0.0006903010371279921, 0.0025511825197629206, 0.9974488174802371], [120.0, 0.03639299938468641, 0.5242530208352, 0.4757469791648001], [160.0, 7.58936252598085e-05, 0.999790942161963, 0.00020905783803698872]], [95, 114, 120, 129, 155], 120.0, 120.0);
    // Geometric::new(0.2)
    check_discrete("Geometric::new(0.2)", try! pkg::Geometric::new(0.2), [[1.0, 0.2, 0.2, 0.8], [2.0, 0.16000000000000003, 0.36, 0.64], [5.0, 0.08192000000000002, 0.67232, 0.32768], [20.0, 0.0028823037615171208, 0.9884707849539315, 0.01152921504606847]], [1, 2, 4, 8, 31], 5.0, 20.0);
    // NegativeBinomial::new(2.5, 0.4)
    check_discrete("NegativeBinomial::new(2.5, 0.4)", try! pkg::NegativeBinomial::new(2.5, 0.4), [[0.0, 0.10119288512538818, 0.10119288512538815, 0.8988071148746118], [1.0, 0.1517893276880823, 0.2529822128134705, 0.7470177871865296], [4.0, 0.1183387545988211, 0.6741406761500156, 0.32585932384998434], [12.0, 0.007988391614154489, 0.9843839077671489, 0.015616092232851304]], [0, 2, 3, 6, 19], 3.75, 9.374999999999998);
}

#[test]
fn tails() {
    // mpmath: I_x(15/2, 1/2) / 2 at x = 15 / (15 + 40^2).
    rel((try! pkg::StudentT::new(15.0)).sf(40.0), 5.845330620433199e-17, 1e-13, "t tail");
    rel((try! pkg::ChiSquared::new(3.0)).sf(400.0), 2.2138865931011176e-86, 1e-13, "chi2 tail");
    rel(pkg::Normal::standard().cdf(-35.0), 1.1249107064724062e-268, 1e-14, "normal tail");
    rel((try! pkg::Binomial::new(10000, 0.001)).sf(40), 1.695646952734665e-13, 1e-12, "binomial tail");
    rel((try! pkg::Poisson::new(100.0)).sf(200), 4.626179470195773e-19, 1e-13, "Poisson tail");
    // Closed forms.
    let e = try! pkg::Exponential::new(0.5);
    rel(e.sf(80.0), (-40.0).exp(), 1e-15, "exponential sf");
    rel(e.isf(1e-300), 2.0 * 300.0 * 10.0.ln(), 1e-15, "exponential isf");
    let c = try! pkg::Cauchy::new(0.0, 1.0);
    rel(c.cdf(-1e10), 1.0 / (3.141592653589793 * 1e10), 1e-12, "Cauchy far tail");
    let t1 = try! pkg::StudentT::new(1.0);
    rel(t1.cdf(-3.0), c.cdf(-3.0), 1e-15, "t(1) is Cauchy");
    let chi = try! pkg::ChiSquared::new(2.0);
    rel(chi.sf(5.0), (-2.5).exp(), 1e-15, "chi2(2) is exponential");
    let f = try! pkg::FisherF::new(1.0, 10.0);
    let t = try! pkg::StudentT::new(10.0);
    rel(f.sf(4.0), 2.0 * t.sf(2.0), 1e-14, "F(1, n) = t(n)^2");
}

#[test]
fn bad_parameters() {
    expect(throws_kind(|| { _ = try pkg::Normal::new(0.0, 0.0); }, "InvalidParameter"), "sigma 0");
    expect(throws_kind(|| { _ = try pkg::Normal::new(f64::NAN, 1.0); }, "InvalidParameter"), "mu NaN");
    expect(throws_kind(|| { _ = try pkg::Gamma::new(-1.0, 1.0); }, "InvalidParameter"), "gamma shape");
    expect(throws_kind(|| { _ = try pkg::Uniform::new(2.0, 1.0); }, "InvalidParameter"), "uniform order");
    expect(throws_kind(|| { _ = try pkg::Binomial::new(-1, 0.5); }, "InvalidParameter"), "binomial n");
    expect(throws_kind(|| { _ = try pkg::Bernoulli::new(1.5); }, "InvalidParameter"), "probability");
    expect(throws_kind(|| { _ = try pkg::StudentT::new(f64::INFINITY); }, "InvalidParameter"), "t inf");
    expect(throws_kind(|| { _ = try pkg::Multinomial::new(3, [0.5, 0.6]); }, "InvalidParameter"), "probabilities sum");
    let s: Matrix<f64> = [[1, 2], [2, 1]];
    let mu: Vector<f64> = [0, 0];
    expect(throws_kind(|| { _ = try pkg::MultivariateNormal::new(mu, s); }, "Singular"), "not positive definite");
    let e = try { _ = try pkg::Normal::new(0.0, -1.0); "" } catch e: pkg::StatsError { f"{e}" };
    expect(e.contains("sigma") && e.contains("> 0"), "message says what to pass");
}

#[test]
fn multivariate() {
    let mu: Vector<f64> = [1, -1];
    let s: Matrix<f64> = [[4, 1.2], [1.2, 1]];
    let d = try! pkg::MultivariateNormal::new(mu, s);
    // det = 4 - 1.44 = 2.56.
    rel(d.logdet(), 2.56.ln(), 1e-15, "logdet");
    let x: Vector<f64> = [2, 0];
    // (x - mu)^T S^-1 (x - mu) with S^-1 = [[1, -1.2], [-1.2, 4]] / 2.56.
    let q = (1.0 - 2.4 + 4.0) / 2.56;
    rel(try! d.mahalanobis(x), q, 1e-14, "mahalanobis");
    rel(try! d.logpdf(x), -(2.0 * 3.141592653589793).ln() - 0.5 * 2.56.ln() - 0.5 * q, 1e-15, "logpdf");
    let m = try! pkg::Multinomial::new(6, [0.2, 0.3, 0.5]);
    // 6! / (1! 2! 3!) 0.2 0.3^2 0.5^3 = 60 * 0.00225.
    rel(try! m.pmf([1, 2, 3]), 0.135, 1e-14, "multinomial pmf");
    expect(try! m.pmf([1, 2, 2]) == 0.0, "wrong total");
    let c = m.cov();
    rel(c[0, 1], -6.0 * 0.2 * 0.3, 1e-15, "multinomial cov");
}

#[test]
fn fits() {
    let x = [2.1, 3.4, 1.9, 5.6, 4.4, 3.3, 2.8, 4.1, 3.9, 2.5];
    let n = try! pkg::Normal::fit(x);
    rel(n.mu(), pkg::mean(x), 0.0, "normal mu");
    rel(n.sigma(), pkg::std(x), 0.0, "normal sigma (ddof 0)");
    // SciPy: gamma.fit(x, floc=0)[0].
    let g = try! pkg::Gamma::fit(x);
    rel(g.shape(), 9.890981792495753, 1e-10, "gamma shape");
    rel(g.shape() * g.scale(), pkg::mean(x), 1e-15, "gamma mean");
    let e = try! pkg::Exponential::fit(x);
    rel(e.rate(), 1.0 / pkg::mean(x), 1e-15, "exponential rate");
    let p = try! pkg::Poisson::fit([0, 1, 1, 2, 6]);
    expect(p.lambda() == 2.0, "poisson");
    expect(throws_kind(|| { _ = try pkg::Poisson::fit([1.5]); }, "InvalidArgument"), "poisson non-integer");
    expect(throws_kind(|| { _ = try pkg::LogNormal::fit([1.0, -1.0]); }, "InvalidArgument"), "lognormal negative");
    expect(throws_kind(|| { _ = try pkg::Normal::fit([1.0]); }, "TooFew"), "normal one value");
    let u = try! pkg::Uniform::fit(x);
    expect(u.a() == 1.9 && u.b() == 5.6, "uniform");
    let l = try! pkg::Laplace::fit(x);
    expect(l.location() == pkg::median(x), "laplace location");
    let rows: Matrix<f64> = [[1, 2], [3, 3], [2, 7], [4, 4]];
    let mv = try! pkg::MultivariateNormal::fit(rows);
    rel(mv.cov()[0, 1], (try! pkg::cov(rows, 0))[0, 1], 1e-15, "mvn cov");
}
