// The beta distribution on [0, 1].

use pkg::StatsError;
use pkg::dist::{Continuous, Distribution, check, draw};
use specfun::{betainc_factor as beta_prefix, betainc_pq as ibeta, betainccinv, betaincinv, lbeta};
use std::random::Rng;

/// The beta distribution with shapes `a, b > 0` on [0, 1]. The CDF is
/// the regularized incomplete beta function; draws from two gamma
/// deviates.
///
/// ```nabi
/// use stats::{Beta, Continuous};
///
/// let d = try Beta::new(2.0, 3.0);
/// assert(d.mean() == 0.4);
/// assert((d.cdf(0.4) - 0.5248).abs() < 1e-15);
/// ```
#[derive(Clone, Copy, PartialEq, Debug)]
pub struct Beta {
    pub(pkg) a: f64;
    pub(pkg) b: f64;
}

impl Beta {
    /// Beta(a, b); both finite and positive.
    pub fn new(a: f64, b: f64) throws (StatsError) -> Beta {
        try check(a > 0.0 && a.is_finite() && b > 0.0 && b.is_finite(), f"Beta: a = {a}, b = {b}; both shapes must be finite and > 0");
        Beta { a: a, b: b }
    }

    /// The first shape.
    pub fn a(self) -> f64 { self.a }

    /// The second shape.
    pub fn b(self) -> f64 { self.b }
}

impl Distribution for Beta {
    type Value = f64;
    fn sample<G: Rng>(self, ref g: G) -> f64 { draw::beta(ref g, self.a, self.b) }
}

impl Continuous for Beta {
    fn pdf(self, x: f64) -> f64 {
        if x < 0.0 || x > 1.0 { return 0.0; }
        if x == 0.0 || x == 1.0 { return self.logpdf(x).exp(); }
        beta_prefix(self.a, self.b, x, 1.0 - x) / (x * (1.0 - x))
    }
    fn logpdf(self, x: f64) -> f64 {
        if x < 0.0 || x > 1.0 { return f64::NEG_INFINITY; }
        let lx = if x == 0.0 && self.a == 1.0 { 0.0 } else { (self.a - 1.0) * x.ln() };
        let ly = if x == 1.0 && self.b == 1.0 { 0.0 } else { (self.b - 1.0) * (-x).ln_1p() };
        lx + ly - lbeta(self.a, self.b)
    }
    fn cdf(self, x: f64) -> f64 {
        if x != x { return x; }
        if x <= 0.0 { return 0.0; }
        if x >= 1.0 { return 1.0; }
        ibeta(self.a, self.b, x, 1.0 - x).0
    }
    fn sf(self, x: f64) -> f64 {
        if x != x { return x; }
        if x <= 0.0 { return 1.0; }
        if x >= 1.0 { return 0.0; }
        ibeta(self.a, self.b, x, 1.0 - x).1
    }
    fn ppf(self, p: f64) -> f64 { betaincinv(self.a, self.b, p) }
    fn isf(self, q: f64) -> f64 { betainccinv(self.a, self.b, q) }
    fn mean(self) -> f64 { self.a / (self.a + self.b) }
    fn var(self) -> f64 {
        let c = self.a + self.b;
        self.a * self.b / (c * c * (c + 1.0))
    }
}
