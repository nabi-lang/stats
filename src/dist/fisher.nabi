// The F distribution (Fisher-Snedecor) with d1 and d2 degrees of freedom.

use pkg::StatsError;
use pkg::dist::{Continuous, Distribution, check, draw};
use specfun::{betainc_pq as ibeta, betainccinv, betaincinv, lbeta};
use std::random::Rng;

/// The F distribution with `d1, d2 > 0` degrees of freedom: the ratio
/// of two scaled chi-squared variables. CDF `I_x(d1 / 2, d2 / 2)` with
/// `x = d1 f / (d1 f + d2)`.
///
/// ```nabi
/// use stats::{Continuous, FisherF};
///
/// let d = try FisherF::new(3.0, 20.0);
/// assert((d.sf(3.0983912121407795) - 0.05).abs() < 1e-14);
/// ```
#[derive(Clone, Copy, PartialEq, Debug)]
pub struct FisherF {
    pub(pkg) d1: f64;
    pub(pkg) d2: f64;
}

impl FisherF {
    /// F(d1, d2); both finite and positive.
    pub fn new(d1: f64, d2: f64) throws (StatsError) -> FisherF {
        try check(d1 > 0.0 && d1.is_finite() && d2 > 0.0 && d2.is_finite(), f"FisherF: d1 = {d1}, d2 = {d2}; both degrees of freedom must be finite and > 0");
        FisherF { d1: d1, d2: d2 }
    }

    /// The numerator degrees of freedom.
    pub fn df1(self) -> f64 { self.d1 }

    /// The denominator degrees of freedom.
    pub fn df2(self) -> f64 { self.d2 }

    fn from_u(self, u: f64, w: f64) -> f64 { self.d2 * u / (self.d1 * w) }

    fn inv(self, p: f64, lower: bool) -> f64 {
        if !(p >= 0.0 && p <= 1.0) { return f64::NAN; }
        let (a, b) = (0.5 * self.d1, 0.5 * self.d2);
        let u = if lower { betaincinv(a, b, p) } else { betainccinv(a, b, p) };
        if u < 0.5 { return self.from_u(u, 1.0 - u); }
        // w = 1 - u from the other side: I_w(b, a) = 1 - I_u(a, b).
        let w = if lower { betainccinv(b, a, p) } else { betaincinv(b, a, p) };
        self.from_u(1.0 - w, w)
    }
}

impl Distribution for FisherF {
    type Value = f64;
    fn sample<G: Rng>(self, ref g: G) -> f64 {
        let x = draw::gamma(ref g, 0.5 * self.d1) / self.d1;
        let y = draw::gamma(ref g, 0.5 * self.d2) / self.d2;
        x / y
    }
}

impl Continuous for FisherF {
    fn pdf(self, x: f64) -> f64 {
        if x < 0.0 { return 0.0; }
        self.logpdf(x).exp()
    }
    fn logpdf(self, x: f64) -> f64 {
        if x < 0.0 { return f64::NEG_INFINITY; }
        let (a, b) = (0.5 * self.d1, 0.5 * self.d2);
        let lx = if x == 0.0 && a == 1.0 { 0.0 } else { (a - 1.0) * x.ln() };
        a * (self.d1 / self.d2).ln() + lx - (a + b) * (self.d1 * x / self.d2).ln_1p() - lbeta(a, b)
    }
    fn cdf(self, x: f64) -> f64 {
        if x != x { return x; }
        if x <= 0.0 { return 0.0; }
        if x == f64::INFINITY { return 1.0; }
        let s = self.d1 * x + self.d2;
        ibeta(0.5 * self.d1, 0.5 * self.d2, self.d1 * x / s, self.d2 / s).0
    }
    fn sf(self, x: f64) -> f64 {
        if x != x { return x; }
        if x <= 0.0 { return 1.0; }
        if x == f64::INFINITY { return 0.0; }
        let s = self.d1 * x + self.d2;
        ibeta(0.5 * self.d1, 0.5 * self.d2, self.d1 * x / s, self.d2 / s).1
    }
    fn ppf(self, p: f64) -> f64 { self.inv(p, true) }
    fn isf(self, q: f64) -> f64 { self.inv(q, false) }
    fn mean(self) -> f64 { if self.d2 > 2.0 { self.d2 / (self.d2 - 2.0) } else { f64::NAN } }
    fn var(self) -> f64 {
        let (d1, d2) = (self.d1, self.d2);
        if d2 <= 4.0 { return if d2 > 2.0 { f64::INFINITY } else { f64::NAN }; }
        2.0 * d2 * d2 * (d1 + d2 - 2.0) / (d1 * (d2 - 2.0) * (d2 - 2.0) * (d2 - 4.0))
    }
}
