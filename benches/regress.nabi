// Least squares on 1e5 x 20 (with the intercept, 21 columns), logistic
// regression on 1e4 x 5, and a two-sample test. Items are rows.

use core::array::{Array, Matrix, Vector};
use core::bench::Bench;
use core::hint::black_box;
use std::random::{Rng, Xoshiro256PlusPlus};

fn design(n: usize, k: usize, seed: u64) -> (Matrix<f64>, Vector<f64>) {
    let g = Xoshiro256PlusPlus::seed(seed);
    let xs: List<f64> = List::with_capacity(n * k);
    for _ in 0..n * k { xs.push(g.uniform(-1.0, 1.0)); }
    let x: Matrix<f64> = Array::from_list(xs, [n, k]);
    let ys: List<f64> = List::with_capacity(n);
    for i in 0..n {
        let s = 0.5;
        for j in 0..k { s += (j + 1) as f64 * 0.1 * x[i, j]; }
        ys.push(s + g.normal());
    }
    (x, Array::from_list(ys, [n]))
}

#[bench]
fn ols_1e5x20(b: Bench) {
    let (x, y) = design(100000, 20, 1);
    b.set_items(100000);
    b.iter(|| try! pkg::ols(black_box(x), black_box(y)));
}

#[bench]
fn logistic_1e4x5(b: Bench) {
    let (x, y) = design(10000, 5, 2);
    let yb: Vector<f64> = y.map(|t: f64| -> f64 { if t > 0.5 { 1.0 } else { 0.0 } });
    b.set_items(10000);
    b.iter(|| try! pkg::logistic(black_box(x), black_box(yb)));
}

#[bench]
fn mannwhitney_1e5(b: Bench) {
    let (x, y) = design(100000, 1, 3);
    b.set_items(200000);
    b.iter(|| try! pkg::mannwhitneyu(black_box(x[:, 0]), black_box(y)));
}
