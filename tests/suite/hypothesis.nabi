const SLEEP1: [f64; 10] = [0.7, -1.6, -0.2, -1.2, -0.1, 3.4, 3.7, 0.8, 0.0, 2.0];
const SLEEP2: [f64; 10] = [1.9, 0.8, 1.1, 0.1, -0.1, 4.4, 5.5, 1.6, 4.6, 3.4];

fn v<const N: usize>(a: [f64; N]) -> Vector<f64> { Array::from_list(List::from_fn(N, |i| a[i]), [N]) }

#[test]
fn t_tests() {
    let (a, b) = (v(SLEEP1), v(SLEEP2));
    // R: t.test(extra ~ group, sleep, paired = TRUE): t = -4.0621, df = 9.
    let p = try! pkg::ttest_rel(a, b);
    rel(p.statistic, PAIRED[0], 1e-14, "paired t");
    rel(p.pvalue, PAIRED[1], 1e-13, "paired p");
    expect(p.df == 9.0, "paired df");
    let w = try! pkg::ttest_ind(a, b);
    rel(w.statistic, WELCH[0], 1e-14, "welch t");
    rel(w.pvalue, WELCH[1], 1e-13, "welch p");
    rel(w.df, WELCH[2], 1e-14, "welch df");
    let s = try! pkg::ttest_ind(a, b, equal_var: true);
    rel(s.statistic, STUDENT[0], 1e-14, "student t");
    rel(s.pvalue, STUDENT[1], 1e-13, "student p");
    let g = try! pkg::ttest_1samp(a, 0.0, Alternative::Greater);
    rel(g.pvalue, ONE_GREATER[1], 1e-13, "one-sided p");
    let ci = (try! pkg::ttest_1samp(a, 0.0)).ci(0.95);
    // SciPy's t quantile is good to about 1e-11 (mpmath); ours to 1e-15.
    rel(ci.lo, ONE_CI[0], 1e-10, "ci lo");
    rel(ci.hi, ONE_CI[1], 1e-10, "ci hi");
    let ci2 = w.ci(0.9);
    rel(ci2.lo, WELCH_CI90[0], 1e-10, "welch ci lo");
    rel(ci2.hi, WELCH_CI90[1], 1e-10, "welch ci hi");
    expect(throws_kind(|| { _ = try pkg::ttest_1samp([1.0], 0.0); }, "TooFew"), "one value");
    expect(throws_kind(|| { _ = try pkg::ttest_rel([1.0, 2.0], [1.0, 2.0, 3.0]); }, "ShapeMismatch"), "pairs");
    expect(throws_kind(|| { _ = try pkg::ttest_ind([1.0, f64::NAN], [1.0, 2.0]); }, "NotFinite"), "NaN");
}

#[test]
fn chi_square() {
    let n = 556.0;
    let e: Vector<f64> = [n * 9.0 / 16.0, n * 3.0 / 16.0, n * 3.0 / 16.0, n / 16.0];
    let m = try! pkg::chisquare([315.0, 108.0, 101.0, 32.0], e);
    rel(m.statistic, MENDEL[0], 1e-14, "Mendel chi2");
    rel(m.pvalue, MENDEL[1], 1e-14, "Mendel p");
    expect(m.df == 3.0, "Mendel df");
    let t: Matrix<f64> = [[12, 5], [7, 14]];
    let y = try! pkg::chi2_contingency(t);
    rel(y.statistic, YATES[0], 1e-14, "Yates");
    rel(y.pvalue, YATES[1], 1e-13, "Yates p");
    let c = try! pkg::chi2_contingency(t, correction: false);
    rel(c.statistic, NOYATES[0], 1e-14, "uncorrected");
    rel(c.pvalue, NOYATES[1], 1e-13, "uncorrected p");
    rel(c.expected[0, 0], 17.0 * 19.0 / 38.0, 1e-15, "expected");
    expect(throws_kind(|| { _ = try pkg::chisquare([1.0, 2.0], [1.0, 1.0]); }, "InvalidArgument"), "totals differ");
    let z: Matrix<f64> = [[0, 0], [1, 2]];
    expect(throws_kind(|| { _ = try pkg::chi2_contingency(z); }, "InvalidArgument"), "empty row");
}

#[test]
fn fisher() {
    let tea: Matrix<f64> = [[3, 1], [1, 3]];
    let r = try! pkg::fisher_exact(tea);
    // Fisher (1935): P = 17 / 35 for the observed table or a more extreme one, both ways.
    rel(r.pvalue, 17.0 / 35.0, 1e-15, "tea");
    let t: Matrix<f64> = [[8, 2], [1, 5]];
    let f = try! pkg::fisher_exact(t);
    expect(f.statistic == FISHER[0], "odds ratio");
    rel(f.pvalue, FISHER[1], 1e-14, "two-sided");
    rel((try! pkg::fisher_exact(t, Alternative::Greater)).pvalue, FISHER_G[0], 1e-14, "greater");
    rel((try! pkg::fisher_exact(t, Alternative::Less)).pvalue, FISHER_L[0], 1e-14, "less");
    let big: Matrix<f64> = [[1, 2, 3], [4, 5, 6]];
    expect(throws_kind(|| { _ = try pkg::fisher_exact(big); }, "InvalidArgument"), "2 x 2 only");
}

#[test]
fn kolmogorov_smirnov() {
    let (xn, xu) = (v(XN), v(XU));
    let z = Normal::standard();
    let r = try! pkg::kstest(xn, z);
    rel(r.statistic, KS_N[0], 1e-15, "ks D");
    rel(r.pvalue, KS_N[1], 1e-12, "ks p (exact)");
    let g = try! pkg::kstest(xn, z, Alternative::Greater);
    rel(g.pvalue, KS_G[1], 1e-12, "ks greater");
    let l = try! pkg::kstest(xn, z, Alternative::Less);
    rel(l.statistic, KS_L[0], 1e-15, "ks D-");
    rel(l.pvalue, KS_L[1], 1e-12, "ks less");
    let u = try! pkg::kstest(xu, try! Normal::new(0.5, 0.3));
    rel(u.pvalue, KS_U[1], 1e-11, "ks small p");
    // n = 1000: past the exact matrix, Stephens' approximation.
    let b = try! pkg::kstest(v(BIGN), z);
    rel(b.statistic, KS_BIG[0], 1e-15, "ks D, n = 1000");
    rel(b.pvalue, KS_BIG[1], 2e-3, "ks p, n = 1000");
    let t = try! pkg::ks_2samp(xn, xu);
    rel(t.statistic, KS2[0], 1e-15, "ks2 D");
    rel(t.pvalue, KS2[1], 1e-10, "ks2 p");
    rel((try! pkg::ks_2samp(xn, xu, Alternative::Less)).pvalue, KS2_L[1], 1e-10, "ks2 less");
    rel((try! pkg::ks_2samp(xn, xu, Alternative::Greater)).pvalue, KS2_G[1], 1e-10, "ks2 greater");
    // A perfect fit at n = 1 has D = 1/2.
    expect((try! pkg::kstest([0.0], z)).statistic == 0.5, "n = 1");
}

#[test]
fn shapiro_wilk() {
    let xn = v(XN);
    let refs = [SW3, SW5, SW8, SW11, SW20, SW40];
    let ns = [3usize, 5, 8, 11, 20, 40];
    for i in 0..6 {
        let r = try! pkg::shapiro(xn[:ns[i]]);
        rel(r.statistic, refs[i][0], 1e-6, f"W at n = {ns[i]}");
        rel(r.pvalue, refs[i][1], 1e-5, f"p at n = {ns[i]}");
    }
    let u = try! pkg::shapiro(v(XU));
    rel(u.pvalue, SWU[1], 1e-5, "uniform sample");
    let b = try! pkg::shapiro(v(BIGN));
    rel(b.statistic, SWBIG[0], 1e-6, "n = 1000");
    expect(throws_kind(|| { _ = try pkg::shapiro([1.0, 2.0]); }, "TooFew"), "two values");
    expect(throws_kind(|| { _ = try pkg::shapiro([1.0, 1.0, 1.0]); }, "InvalidArgument"), "constant");
}

#[test]
fn rank_tests() {
    let (xn, xu) = (v(XN), v(XU));
    let m = try! pkg::mannwhitneyu(xn[:6], xu[:9]);
    expect(m.statistic == MWU_EXACT[0], "U");
    rel(m.pvalue, MWU_EXACT[1], 1e-14, "U exact p");
    rel((try! pkg::mannwhitneyu(xn[:6], xu[:9], Alternative::Less)).pvalue, MWU_EXACT_L[1], 1e-14, "U exact less");
    let (a, b) = (v(TA), v(TB));
    let t = try! pkg::mannwhitneyu(a, b);
    expect(t.statistic == MWU_TIES[0], "U with ties");
    rel(t.pvalue, MWU_TIES[1], 1e-13, "U normal approx with ties");
    rel((try! pkg::mannwhitneyu(a, b, Alternative::Greater)).pvalue, MWU_TIES_G[1], 1e-13, "U greater");
    let w = try! pkg::wilcoxon(xn[:20]);
    expect(w.statistic == WIL_EXACT[0], "W");
    rel(w.pvalue, WIL_EXACT[1], 1e-14, "W exact");
    rel((try! pkg::wilcoxon(xn[:20], alternative: Alternative::Greater)).pvalue, WIL_EXACT_G[1], 1e-14, "W greater");
    let wt = try! pkg::wilcoxon(a);
    expect(wt.statistic == WIL_TIES[0], "W with ties and zeros");
    rel(wt.pvalue, WIL_TIES[1], 1e-13, "W approx");
    rel((try! pkg::wilcoxon(xn)).pvalue, WIL_40[1], 1e-14, "W exact n = 40");
    rel((try! pkg::wilcoxon(v(BIGN))).pvalue, WIL_BIG[1], 1e-12, "W n = 1000");
    let d = try! pkg::wilcoxon(xn[:20], xn[:20] .* 0.5);
    let h = try! pkg::wilcoxon(xn[:20] .* 0.5);
    expect(d.statistic == h.statistic && d.pvalue == h.pvalue, "paired form");
    expect(throws_kind(|| { _ = try pkg::wilcoxon([0.0, 0.0]); }, "TooFew"), "all zero");
}

#[test]
fn correlation_tests() {
    let (xn, xu) = (v(XN), v(XU));
    let p = try! pkg::pearsonr(xn[:30], xu);
    rel(p.statistic, PEARSONR[0], 1e-14, "r");
    rel(p.pvalue, PEARSONR[1], 1e-13, "r p");
    expect(p.df == 28.0, "r df");
    let s = try! pkg::spearmanr(xn[:30], xu);
    rel(s.statistic, SPEARMANR[0], 1e-14, "rho");
    rel(s.pvalue, SPEARMANR[1], 1e-13, "rho p");
    let k = try! pkg::kendalltau(xn[:30], xu);
    rel(k.statistic, KENDALL_EXACT[0], 1e-14, "tau");
    rel(k.pvalue, KENDALL_EXACT[1], 1e-13, "tau exact p");
    let kt = try! pkg::kendalltau(v(TA)[:30], v(TB));
    rel(kt.statistic, KENDALL_TIES[0], 1e-14, "tau-b with ties");
    rel(kt.pvalue, KENDALL_TIES[1], 1e-13, "tau-b p");
    let k4 = try! pkg::kendalltau(xn, v(BIGN)[:40]);
    rel(k4.pvalue, KENDALL_40[1], 1e-13, "tau normal approx");
    let perfect = try! pkg::pearsonr([1.0, 2.0, 3.0], [2.0, 4.0, 6.0]);
    expect(perfect.statistic == 1.0 && perfect.pvalue == 0.0, "perfect correlation");
}

#[test]
fn anova() {
    // Montgomery, ex. 3.1: F = 66.80, P < 0.01.
    let a = [575.0, 542.0, 530.0, 539.0, 570.0];
    let b = [565.0, 593.0, 590.0, 579.0, 610.0];
    let c = [600.0, 651.0, 610.0, 637.0, 629.0];
    let d = [725.0, 700.0, 715.0, 685.0, 710.0];
    let r = try! pkg::f_oneway([a, b, c, d]);
    close(r.statistic, 66.79707321945864, 1e-11, "etch F");
    rel(r.pvalue, 2.882865908493268e-09, 1e-11, "etch p (SciPy)");
    expect(r.df_between == 3.0 && r.df_within == 16.0, "df");
    let xn = v(XN);
    let g = try! pkg::f_oneway([xn[:10], xn[10:25] .+ 0.4, v(XU)]);
    rel(g.statistic, ANOVA[0], 1e-13, "F");
    rel(g.pvalue, ANOVA[1], 1e-12, "F p");
    expect(throws_kind(|| { _ = try pkg::f_oneway([[1.0, 2.0]]); }, "TooFew"), "one group");
}
