    [0.4, 0.5333333333333333, 1.1, 2.5500000000000003, 3.9, 4.71, 9.2, 12.409999999999995, 12.5],
    [0.4, 0.5525000000000001, 1.11, 2.55625, 3.9, 4.70675, 9.170000000000002, 12.304249999999996, 12.5],
